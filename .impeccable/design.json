{
  "product": "Compasso",
  "mode": "Operate",
  "source": "src/style.css",
  "note": "Inventário dos valores implementados. Valores sem cssVariable são literais no CSS; espaçamento não usa uma escala global.",
  "colors": {
    "background": { "value": "#f7f6f0" },
    "ink": { "value": "#243c35", "cssVariable": "--ink" },
    "primary": { "value": "#214b3d", "cssVariable": "--green" },
    "muted": { "value": "#52665e", "cssVariable": "--muted" },
    "line": { "value": "#d9ded4", "cssVariable": "--line" },
    "accent": { "value": "#b8462d", "cssVariable": "--coral" },
    "recoveryPanel": { "value": "#e9eddf" },
    "currentBlock": { "value": "#edf1e5" },
    "error": { "value": "#9d341f" },
    "buttonHover": { "value": "#e8ece3" },
    "primaryHover": { "value": "#16382d" },
    "selection": { "value": "#d8e7ad" },
    "timeline": ["#8eaa81", "#b9c8a2", "#d7ddc7", "#466652"]
  },
  "fonts": {
    "body": "'DM Sans', sans-serif",
    "headings": "'Newsreader', Georgia, serif",
    "h1": { "size": "clamp(36px, 4vw, 54px)", "weight": 400, "lineHeight": 1.1, "letterSpacing": "-0.035em", "mobileSize": "40px" },
    "h2": { "size": "31px", "weight": 400, "lineHeight": 1.12, "letterSpacing": "-0.025em" },
    "h3": { "size": "17px", "weight": 500 },
    "paragraphLineHeight": 1.6,
    "timeNumerals": "tabular-nums"
  },
  "spacing": {
    "mainPadding": "30px 5% 0",
    "workspaceGap": "42px",
    "agendaRowPadding": "24px 0",
    "recoveryPadding": "26px",
    "buttonPadding": "9px 13px",
    "dialogPadding": "30px"
  },
  "layout": {
    "mainMaxWidth": "1380px",
    "workspaceColumns": "minmax(0, 1fr) 320px",
    "agendaColumns": "75px 1fr 80px",
    "topbarHeight": "90px",
    "dialogWidth": "510px",
    "dialogMaxWidth": "calc(100vw - 28px)",
    "dialogMaxHeight": "90vh"
  },
  "radii": { "controls": "5px", "dialog": "12px", "exampleTag": "3px" },
  "breakpoints": [
    { "query": "(max-width: 1000px)", "workspaceColumns": "minmax(0, 1fr) 290px", "workspaceGap": "24px", "recoveryPadding": "22px", "agendaColumns": "60px 1fr 65px" },
    { "query": "(max-width: 760px)", "workspaceDirection": "column", "workspaceGap": "32px", "mainPadding": "24px 6% 0", "recoveryPadding": "27px", "agendaColumns": "50px minmax(0, 1fr) 53px", "topbarHeight": "74px", "dialogPadding": "23px" },
    { "query": "(min-width: 1400px)", "mainHorizontalPadding": "48px", "topbarHorizontalPadding": "max(5%, calc((100vw - 1284px) / 2))" }
  ],
  "interaction": {
    "focusOutline": "3px solid #b8462d",
    "focusOutlineOffset": "3px",
    "transition": "background-color .15s ease-out",
    "defaultButtonMinHeight": "42px",
    "blockTitleButtonMinHeight": "25px",
    "rowActionDesktop": { "width": "32px", "minHeight": "32px" },
    "rowActionMobile": { "width": "27px", "minHeight": "40px" },
    "mobileShortcutMinHeight": "44px",
    "reducedMotion": "Transições e animações removidas.",
    "print": "Agenda sem controles e sem painel lateral."
  }
}
